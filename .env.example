# Vectra-Orbit Environment Settings

# Active Providers (Switch provider by changing string value)
VAD_PROVIDER=silero          # Options: "silero", "energy", "target_speaker"
TARGET_SPEAKER_THRESHOLD=0.60
TARGET_SPEAKER_ENROLL_SECONDS=1.0
STT_PROVIDER=groq            # Options: "groq", "faster_whisper", "mock"
LLM_PROVIDER=groq            # Options: "groq", "ollama", "mock"
TTS_PROVIDER=edge            # Options: "edge", "mock"
TELEPHONY_PROVIDER=web       # Options: "web", "twilio"

# API Keys (Groq is 100% free cloud tier with ultra-low latency)
GROQ_API_KEY=your_free_groq_api_key_here

# Local Ollama Settings (Optional free local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database Settings (Default: SQLite local zero-setup; or PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/vectra_orbit)
DATABASE_URL=sqlite+aiosqlite:///./vectra_orbit.db

# Default Call Transfer / Forwarding Target
DEFAULT_HUMAN_AGENT_PHONE=+18005550199
